{
  "name": "livora-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "dotenvx run -- next dev -p 3200",
    "build": "dotenvx run -- next build",
    "start": "dotenvx run -- next start -p 3200",
    "lint": "eslint",
    "fmt": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "fmt:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.28.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.15.1",
  "prettier": {
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "semi": false,
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
